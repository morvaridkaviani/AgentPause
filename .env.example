# Copy to .env and adjust. Never commit .env.

# --- Backend (FastAPI) ---
# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://agentpause:CHANGE_ME@localhost:5432/agentpause
DATABASE_URL=sqlite:///./data/agentpause.db
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3100
# Protects study configuration, exports, and other researcher endpoints. Empty = open (local development only).
AGENTPAUSE_ADMIN_TOKEN=
# development | production
AGENTPAUSE_ENV=development
# Upper bounds on simulated episodes per API request.
MAX_EXPERIMENT_EPISODES=20000
MAX_COMPARE_EPISODES=3000
# Directory with licensed questionnaire items that are not bundled (see docs/experiments.md).
INSTRUMENTS_LOCAL_DIR=

# --- Frontend (Next.js) ---
# Where Next.js forwards /api/v1, /docs, and /redoc. Compiled into the build.
BACKEND_URL=http://localhost:8000
# Optional link to the source repository shown in the footer.
NEXT_PUBLIC_REPO_URL=https://github.com/morvaridkaviani/AgentPause

# --- docker compose (postgres profile) ---
POSTGRES_PASSWORD=CHANGE_ME
