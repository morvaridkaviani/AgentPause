{
  "id": "shopping",
  "name": "Online shopping",
  "agent_name": "Shopping Agent",
  "domain": "shopping",
  "icon": "cart",
  "description": "Order office supplies with a company card. Includes a payment verification step that only the user can do.",
  "goal": "Order toner for the office printer and a box of A4 paper with the company card. We need it before Thursday.",
  "brief": "The office printer is a {printer_model}. You want {quantity}. Delivery must arrive {delivery_deadline}.",
  "assumptions": [
    {
      "id": "printer_model",
      "description": "the office printer is an HP LaserJet M404",
      "kind": "input",
      "confidence": 0.75,
      "agent_value": "HP LaserJet M404",
      "alternatives": ["HP LaserJet M428"],
      "introduced_at": "search_products",
      "if_wrong": "Incompatible toner would be ordered."
    },
    {
      "id": "delivery_deadline",
      "description": "'before Thursday' means delivery by Wednesday 15 October",
      "kind": "constraint",
      "confidence": 0.9,
      "agent_value": "by Wed 15 Oct",
      "alternatives": ["by Thu 16 Oct (inclusive)"],
      "introduced_at": "search_products",
      "if_wrong": "The cheapest shipping option might arrive too late."
    },
    {
      "id": "quantity",
      "description": "you want one toner cartridge",
      "kind": "input",
      "confidence": 0.78,
      "agent_value": "1 cartridge",
      "alternatives": ["2 cartridges (one spare)"],
      "introduced_at": "add_toner_to_cart",
      "if_wrong": "Too few (or too many) cartridges would be ordered."
    }
  ],
  "steps": [
    {
      "id": "search_products",
      "label": "Search products",
      "description": "Search toner for {printer_model} and A4 paper",
      "subtask": "Find products",
      "category": "read_only",
      "agent_confidence": 0.95,
      "depends_on": ["printer_model"],
      "breakpoint": true,
      "load": 0.4,
      "duration_s": 5,
      "consequence": "No side effects",
      "undo": "Nothing to undo",
      "what_could_go_wrong": "Searching for the wrong model wastes a little time.",
      "preview": {"Query": "toner {printer_model}; A4 paper 500 sheets"}
    },
    {
      "id": "compare_offers",
      "label": "Compare offers",
      "description": "Compare 9 toner offers compatible with {printer_model}",
      "subtask": "Find products",
      "category": "read_only",
      "agent_confidence": 0.92,
      "depends_on": ["printer_model", "delivery_deadline"],
      "breakpoint": false,
      "load": 0.5,
      "duration_s": 7,
      "consequence": "No side effects",
      "undo": "Nothing to undo",
      "what_could_go_wrong": "Compatible offers could be missed.",
      "preview": {"Best offer": "HP 59A original toner, €89, delivery {delivery_deadline}"}
    },
    {
      "id": "add_toner_to_cart",
      "label": "Add toner to cart",
      "description": "Add HP 59A toner ({quantity}) to the cart",
      "subtask": "Fill cart",
      "category": "internal_draft",
      "severity": 0.05,
      "recoverability": 1.0,
      "agent_confidence": 0.9,
      "depends_on": ["printer_model", "quantity"],
      "breakpoint": false,
      "load": 0.5,
      "duration_s": 3,
      "consequence": "Item in cart; nothing ordered",
      "undo": "Remove from cart",
      "what_could_go_wrong": "The wrong variant or quantity could end up in the cart.",
      "preview": {"Item": "HP 59A toner (3,000 pages)", "Quantity": "{quantity}", "Price": "€89 each"}
    },
    {
      "id": "add_paper_to_cart",
      "label": "Add paper to cart",
      "description": "Add 1 box of A4 paper (5 × 500 sheets, €24) to the cart",
      "subtask": "Fill cart",
      "category": "internal_draft",
      "agent_confidence": 0.96,
      "depends_on": [],
      "breakpoint": true,
      "load": 0.3,
      "duration_s": 3,
      "consequence": "Item in cart; nothing ordered",
      "undo": "Remove from cart",
      "what_could_go_wrong": "Wrong paper size.",
      "preview": {"Item": "A4 copy paper, 80 g/m², 2,500 sheets", "Price": "€24"}
