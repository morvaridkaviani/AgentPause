    {
      "id": "verify_payment",
      "label": "Verify company card",
      "description": "The company card requires a one-time 3-D Secure code sent to your phone",
      "subtask": "Checkout",
      "category": "account_change",
      "severity": 0.3,
      "recoverability": 1.0,
      "agent_confidence": 0.95,
      "depends_on": [],
      "breakpoint": true,
      "load": 0.3,
      "duration_s": 15,
      "consequence": "Only you can enter the verification code (simulated)",
      "undo": "Nothing to undo",
      "what_could_go_wrong": "Without the code the order cannot be placed.",
      "preview": {"Card": "Company Visa •••• 4417", "Verification": "3-D Secure code required"},
      "requires_human_input": true
    },
    {
      "id": "place_order",
      "label": "Place order",
      "description": "Place the order (€119.90) with the company card (simulated)",
      "subtask": "Checkout",
      "category": "financial_transaction",
      "severity": 0.6,
      "recoverability": 0.3,
      "agent_confidence": 0.9,
      "depends_on": ["printer_model", "quantity", "delivery_deadline"],
      "breakpoint": false,
      "load": 0.35,
      "duration_s": 4,
      "consequence": "Order placed and charged (simulated); cancellable only within 30 minutes",
      "undo": "Cancel within 30 minutes; afterwards a return is required",
      "what_could_go_wrong": "Wrong items, quantity, or delivery date are charged to the company.",
      "preview": {"Items": "HP 59A toner × {quantity}; A4 paper × 1", "Shipping": "Express, {delivery_deadline}", "Total": "€119.90"},
      "alternatives": ["Save the cart and send me a summary", "Ask my manager to approve the order"]
    }
