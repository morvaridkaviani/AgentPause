    {
      "id": "choose_shipping",
      "label": "Choose shipping",
      "description": "Choose express shipping to arrive {delivery_deadline} (+€6.90)",
      "subtask": "Checkout",
      "category": "data_entry",
      "severity": 0.2,
      "recoverability": 0.9,
      "agent_confidence": 0.88,
      "depends_on": ["delivery_deadline"],
      "breakpoint": false,
      "load": 0.4,
      "duration_s": 3,
      "consequence": "Checkout option selected; nothing ordered yet",
      "undo": "Change the shipping option",
      "what_could_go_wrong": "A slower option could arrive too late.",
      "preview": {"Shipping": "Express, arrives {delivery_deadline}", "Cost": "€6.90"}
