  "mistakes": [
    {
      "id": "xl_variant",
      "step": "add_toner_to_cart",
      "description": "The cart contains the XL variant (HP 59X, €189) instead of the standard HP 59A (€89).",
      "probability": 0.12,
      "severity": 0.3,
      "recoverability": 0.3,
      "visible_at": ["add_toner_to_cart", "place_order"],
      "harm_at": "place_order",
      "preview": {
        "add_toner_to_cart": {"Item": "HP 59X toner XL (10,000 pages)", "Price": "€189 each"},
        "place_order": {"Items": "HP 59X toner XL × {quantity}; A4 paper × 1", "Total": "€219.90"}
      }
    },
    {
      "id": "slow_shipping",
      "step": "choose_shipping",
      "description": "Standard shipping was selected; it arrives on Friday, after your deadline.",
      "probability": 0.12,
      "severity": 0.35,
      "recoverability": 0.3,
      "visible_at": ["choose_shipping", "place_order"],
      "harm_at": "place_order",
      "preview": {
        "choose_shipping": {"Shipping": "Standard, arrives Fri 17 Oct", "Cost": "€0"},
        "place_order": {"Shipping": "Standard, arrives Fri 17 Oct", "Total": "€113.00"}
      }
    }
  ]
